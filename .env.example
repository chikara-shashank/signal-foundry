# demo: synthetic, shadow: real data/local fills, paper: Alpaca paper, live: real money
MODE=demo
# dedicated blocks external holdings; shared isolates agent accounting in paper/local modes.
ACCOUNT_POLICY=dedicated
PORT=8080
DATA_DIR=./data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN=replace-with-a-random-token-at-least-32-characters
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_FEED=iex
# Must match the crypto venue applicable to your account: us or us-1
ALPACA_CRYPTO_LOCATION=us
EQUITY_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
STRATEGIES=range_breakout,trend_pullback,failed_breakout,vwap_reversion,volatility_expansion,order_flow_continuation
# Quote-triggered strategy scans are throttled per symbol. This is not an HFT latency guarantee.
QUOTE_SCAN_MS=250
JEV_MODE=off
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MONTHLY_USD=60
JEV_RPM=120
JEV_TIMEOUT_MS=1500
JEV_MIN_COHERENCE=0.8
JEV_MIN_QUALITY=0.65
# Sourced company research + one critic, shadow only. Defaults to shadow in
# paper/shadow modes; off in demo/live. Shares Jev's monthly dollar budget.
# RESEARCH_CONTEXT_MODE=shadow
RESEARCH_CONTEXT_DAILY_CALLS=8
RESEARCH_CONTEXT_SYMBOLS=4
RESEARCH_CONTEXT_TTL_MINUTES=60
CAPITAL_BUDGET_USD=10000
MAX_POSITION_USD=500
MAX_GROSS_USD=2000
MAX_GROUP_USD=1500
RISK_PER_TRADE_USD=10
DAILY_LOSS_USD=100
# 0 disables the combined position/pending-entry count cap; dollar limits still apply.
MAX_POSITIONS=0
EQUITY_FEE_BPS=1
CRYPTO_FEE_BPS=25
SLIPPAGE_BPS=3
MAX_SPREAD_BPS=20
MAX_QUOTE_AGE_MS=5000
MAX_HOLD_MINUTES=60
ENTRY_TTL_SECONDS=20
SYMBOL_COOLDOWN_SECONDS=300
LIVE_ACK=
EXPECTED_ACCOUNT_ID=
# Required for live ranked crypto. CRYPTO_UNIVERSE=off disables new crypto buys.
LIVE_CRYPTO_ACK=
# Optional success-ping URL from an external dead-man monitor. Alert after >3 missed minutes.
HEARTBEAT_URL=

# Crypto uses provider 5m bars in real-data modes. Holding horizon, not a profit promise.
CRYPTO_MAX_HOLD_MINUTES=180
# Provider modes default to top25: global CoinPaprika leaders intersected with
# Alpaca tradable USD pairs. Empty CRYPTO_SYMBOLS no longer disables this scanner.
# Leave blank/commented for demo (static synthetic symbols); use off to disable.
# CRYPTO_UNIVERSE=top25

# Paper/shadow closing-strength + news experiment. Saved dashboard toggle wins.
# New entries only; never converts existing intraday positions into carry trades.
# Engine allocated equity is the denominator; all carry positions + pending buys.
# Default on in paper/shadow and off in demo/live. Maximum cap allowed is 0.095.
# OVERNIGHT_ENTRIES=on
OVERNIGHT_ALLOCATION_FRACTION=0.095
OVERNIGHT_POSITION_FRACTION=0.035
OVERNIGHT_MAX_SESSIONS=3

# Noise-area session strategy (add noise_area to STRATEGIES; shadow, paper or live only).
# Long side only, fixed notional, decisions at :00/:30. The stop is a far protective bracket leg;
# normal exits are the trailing band/VWAP check and the session-end exit.
NOISE_AREA_SYMBOL=QQQ
NOISE_AREA_NOTIONAL_USD=1500
NOISE_AREA_STOP_BPS=150

# Evidence-gated risk levels (docs/RISK-LEVELS.md): demo, shadow and paper only.
# off keeps every limit above exactly as written. auto: a strategy earns Level 2
# (limits x RISK_LEVEL2_MULTIPLIER) after RISK_LEVEL2_MIN_TRADES profitable closed
# trades on the running code, profitable in both halves; Level 3 after
# RISK_LEVEL3_MIN_TRADES, profitable in every third, worst drawdown below net profit.
# It drops back as soon as the evidence stops holding. RISK_LEVEL_MAX is the ceiling.
# The drawdown brake halves trade size at RISK_BRAKE_HALVE_PCT and stops new entries
# at RISK_BRAKE_HALT_PCT of the capital budget in force; a stop holds until
# "Reset drawdown brake" on the Operations tab. No trade risks more than
# RISK_MAX_ACCOUNT_RISK_PCT of account equity.
RISK_LEVELS=off
RISK_LEVEL_MAX=2
RISK_LEVEL2_MULTIPLIER=10
RISK_LEVEL3_MULTIPLIER=50
RISK_LEVEL2_MIN_TRADES=100
RISK_LEVEL3_MIN_TRADES=300
RISK_BRAKE_HALVE_PCT=5
RISK_BRAKE_HALT_PCT=10
RISK_MAX_ACCOUNT_RISK_PCT=0.5
